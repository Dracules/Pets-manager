#CONNECTION FOR LOCAL

MONGO_URI="mongodb://user:password@localhost:27017/db?authSource=admin" #MONGO CONNECTION STRING FOR LOCAL (WITH @localhost)

#JWT CONFIGURATION

JWT_SECRET="JWT_SECRET" #SECRET JWT KEY

JWT_ACCESS_EXPIRES_IN='15m' #ACCESS JWT LIFETIME
JWT_REFRESH_EXPIRES_IN='1d' #REFRESH JWT LIFETIME

#ONLY FOR DOCKER

MONGODB_ADMIN_USER="MONGODB_ADMIN_USER" #ONLY FOR MONGO IN DOCKER MONGO_INITDB_ROOT_USERNAME
MONGODB_ADMIN_PASSWORD="MONGODB_ADMIN_PASSWORD" #ONLY FOR MONGO IN DOCKER MONGO_INITDB_ROOT_PASSWORD
MONGODB_DB="db"  #ONLY FOR MONGO IN DOCKER DB NAME

MONGODB_APP_USER="MONGODB_APP_USER" #MONGO ADMIN PASSWORD FOR TEST DB
MONGODB_APP_PASSWORD="MONGODB_APP_PASSWORD" #MONGO ADMIN PASSWORD FOR TEST DB

#ONLY FOR MONGO IN DOCKER HARDCODED START USERS WITH HARDCODED PASSWORD HASH

MONGODB_USERS_ADMIN_LOGIN="MONGODB_USERS_ADMIN_LOGIN" #LOGIN FOR USER WITH ADMIN ROLE
MONGODB_USERS_ADMIN_PASSWORD_HASH='$2b$12$gsW.iXCMVrLlKfVnk9hTLu6xDamladDbXEeMNCT6FhWNzcfSFkTpK' #PASSWORD HASH (PASSWORD `adminpassword`) FOR USER WITH ADMIN ROLE

MONGODB_USERS_USER_LOGIN="MONGODB_USERS_USER_LOGIN" #LOGIN FOR USER WITH USER ROLE
MONGODB_USERS_USER_PASSWORD_HASH='$2b$12$871gdeHjCblwdmeJJ.5dhOj7KkWeFjeX5uyhKOAdQIoEerWEKmtLi' #PASSWORD HASH (PASSWORD `userpassword`) FOR USER WITH USER ROLE

#ONLY FOR TESTS

MONGODB_USER="MONGODB_USER" #MONGO ADMIN FOR TEST DB
MONGODB_PASSWORD="MONGODB_PASSWORD" #MONGO ADMIN PASSWORD FOR TEST DB

MONGODB_TEST_DB="testdb" #MONGO DB NAME FOR TEST DB 
MONGO_TEST_URI="mongodb://user:password@localhost:27017/testdb?authSource=admin" #MONGO CONNECTION STRING FOR TEST DB (WITH @localhost)

MONGODB_TEST_ADMIN_USER="MONGODB_TEST_ADMIN_USER" #LOGIN FOR USER WITH ADMIN ROLE FOR TEST DB
MONGODB_TEST_ADMIN_PASSWORD="MONGODB_TEST_ADMIN_PASSWORD" #PASSWORD FOR USER WITH ADMIN ROLE FOR TEST DB

MONGODB_TEST_USER="MONGODB_TEST_USER" #LOGIN FOR USER WITH USER ROLE FOR TEST DB
MONGODB_TEST_PASSWORD="MONGODB_TEST_PASSWORD" #PASSWORD FOR USER WITH USER ROLE FOR TEST DB